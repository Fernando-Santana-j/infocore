# Aplicação
PORT=3131
SITE_URL=https://infocoretech.com.br
TRUST_PROXY=1
ASSET_VERSION=
PRODUCT_CATALOG_SYNC=1
# Opcional: diretório de imagens criado pelo sistema de estoque.
PRODUCT_MEDIA_DIR=../InfoCore-System/uploads

# Analytics (use GTM_ID OU GA4_ID direto; prefira GTM para evitar duplicidade)
GTM_ID=
GA4_ID=
CLARITY_ID=
META_PIXEL_ID=

# Avaliações do Google — modo padrão gratuito, sem chave nem OAuth
GOOGLE_REVIEWS_PROVIDER=embed
# Sincroniza as avaliações públicas a cada 12 horas e mantém a última cópia válida.
GOOGLE_REVIEWS_PUBLIC_SYNC=1
# O modo embed usa o nome e o endereço de config/business.js. As opções abaixo
# só são necessárias caso você escolha uma integração avançada no futuro.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=
GOOGLE_REVIEW_WRITE_URL=

# Perfil da Empresa — opcional; exige aprovação e OAuth do Google
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3136/oauth2callback

# Instagram API — aceita token do Instagram Login (IG...) ou Facebook Login (EAA...)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0

# Endpoint seguro que recebe POST JSON do formulário
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
