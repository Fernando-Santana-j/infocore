<meta property="og:site_name" content="<%= business.name %>"><meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDescription %>"><meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:image" content="<%= ogImageUrl %>"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:image:alt" content="InfoCore — assistência técnica e informática em Simão Dias">
