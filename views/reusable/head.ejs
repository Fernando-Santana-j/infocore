<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'InfoCore — informática, manutenção, montagem de PCs e vendas em Simão Dias/SE.' %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="googlebot" content="index, follow">
<meta name="author" content="InfoCore Informática">
<meta name="theme-color" content="#8E44AD">
<meta name="color-scheme" content="dark">
<link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : (typeof siteUrl !== 'undefined' ? siteUrl + '/' : '/') %>">

<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content="InfoCore Informática">
<meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'InfoCore — Informática e manutenção' %>">
<meta property="og:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Manutenção, montagem de PCs, vendas e atendimento em Simão Dias, Sergipe.' %>">
<meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : (typeof siteUrl !== 'undefined' ? siteUrl + '/' : '') %>">
<% if (typeof ogImageUrl !== 'undefined' && ogImageUrl) { %>
<meta property="og:image" content="<%= ogImageUrl %>">
<meta property="og:image:alt" content="InfoCore — informática e tecnologia">
<% } %>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'InfoCore — Informática e manutenção' %>">
<meta name="twitter:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Manutenção, montagem de PCs, vendas e atendimento em Simão Dias, Sergipe.' %>">
<% if (typeof ogImageUrl !== 'undefined' && ogImageUrl) { %>
<meta name="twitter:image" content="<%= ogImageUrl %>">
<% } %>

<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'InfoCore — Informática e Manutenção' %></title>

<link rel="manifest" href="/public/site.webmanifest">
<link rel="apple-touch-icon" href="/public/img/logo_bg.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style-root.css">
