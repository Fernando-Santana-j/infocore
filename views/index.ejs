<!doctype html>
<html lang="pt-BR">
<head><%- include('./reusable/head.ejs') %><%- include('./reusable/seo-jsonld.ejs') %></head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <svg class="svg-sprite" aria-hidden="true"><symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol><symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.55-5.25A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.3 8.1c.3 3.5 2 5.2 5.5 5.6"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2"/></symbol><symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a4.5 4.5 0 0 0-5.5 5.5l-6.3 6.3a2.1 2.1 0 0 0 3 3l6.3-6.3a4.5 4.5 0 0 0 5.5-5.5l-2.6 2.6-3-3Z"/></symbol><symbol id="i-chip" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3M9 9h6v6H9z"/></symbol><symbol id="i-laptop" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="12" rx="2"/><path d="M2 20h20"/></symbol><symbol id="i-drive" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 15h.01M11 15h6"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6Z"/><path d="m8.5 12 2 2 5-5"/></symbol></svg>

  <header class="site-header" id="header">
    <nav class="nav container" aria-label="Navegação principal">
      <a class="brand" href="#inicio" aria-label="InfoCore, início"><img src="/public/img/brand-header.webp" width="180" height="72" alt="InfoCore"></a>
      <button class="menu-toggle" type="button" aria-controls="nav-menu" aria-expanded="false"><span></span><span></span><span></span><span class="sr-only">Abrir menu</span></button>
      <div class="nav-menu" id="nav-menu">
        <a href="#servicos" data-nav="servicos">Serviços</a><a href="#processo" data-nav="processo">Como funciona</a><a href="#trabalhos" data-nav="trabalhos">Trabalhos</a><a href="#faq" data-nav="faq">Dúvidas</a><a href="#contato" data-nav="contato">Contato</a>
        <a class="button button-small button-whatsapp js-whatsapp" href="#" data-section="header" data-label="falar_no_whatsapp"><svg><use href="#i-whatsapp"/></svg> Falar no WhatsApp</a>
      </div>
    </nav>
  </header>

  <main id="conteudo">
    <section class="hero" id="inicio" data-section="hero">
      <div class="hero-grid" aria-hidden="true"></div><div class="hero-orb hero-orb-a" aria-hidden="true"></div><div class="hero-orb hero-orb-b" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow reveal"><span class="pulse"></span> Assistência técnica em Simão Dias · SE</div>
          <h1 class="reveal">Seu equipamento,<br><span>de volta ao ritmo.</span></h1>
          <p class="hero-lead reveal">Manutenção de computadores e notebooks, upgrades e montagem de PCs com diagnóstico claro e atendimento direto.</p>
          <div class="hero-actions reveal"><a class="button button-primary js-whatsapp" href="#" data-section="hero" data-label="solicitar_orcamento"><svg><use href="#i-whatsapp"/></svg> Solicitar orçamento</a><a class="button button-ghost tracked-link" href="#servicos" data-event="hero_cta_click" data-label="ver_servicos">Ver serviços <svg><use href="#i-arrow"/></svg></a></div>
          <ul class="trust-list reveal"><li><svg><use href="#i-check"/></svg> Atendimento local</li><li><svg><use href="#i-check"/></svg> Orçamento antes do serviço</li><li><svg><use href="#i-check"/></svg> Contato sem burocracia</li></ul>
        </div>
        <div class="diagnostic-shell reveal" id="diagnostic" aria-label="Assistente visual para conhecer e melhorar seu dispositivo">
          <div class="diagnostic-top"><span><i></i> INFOCORE / CHECK-UP DIGITAL</span><span class="diag-time" id="diag-state">ANALISANDO</span></div>
          <div class="device-stage" id="device-stage">
            <div class="pc-side" aria-hidden="true">
              <div class="pc-frame"><div class="rear-fan"></div><div class="board"><span class="socket"></span><span class="ram ram-a"></span><span class="ram ram-b"></span><span class="m2"></span></div><div class="gpu"><i></i><i></i></div><div class="psu">PSU</div><div class="front-fan fan-top"></div><div class="front-fan fan-bottom"></div><div class="scan-line"></div></div>
            </div>
            <div class="notebook-device" aria-hidden="true"><div class="notebook-screen"><span></span></div><div class="notebook-base"></div></div>
            <div class="phone-device" aria-hidden="true"><span></span><i></i></div>
            <svg class="device-connectors" aria-hidden="true"><g></g></svg>
            <div class="diag-node node-cpu"><span>PROCESSAMENTO</span><b id="diag-cpu">lendo dispositivo…</b></div>
            <div class="diag-node node-memory"><span>MEMÓRIA</span><b id="diag-memory">verificando…</b></div>
            <div class="diag-node node-storage"><span>ARMAZENAMENTO</span><b id="diag-profile">identificando…</b></div>
            <div class="diag-node node-gpu"><span>VÍDEO / GPU</span><b id="diag-gpu">aguardando…</b></div>
            <div class="diag-node node-model"><span>MODELO</span><b id="diag-model">detectando…</b></div>
            <div class="diag-node node-temperature"><span>TEMPERATURA</span><b id="diag-temp">não disponível</b></div>
          </div>
          <div class="diagnostic-result"><div><small id="diag-device-label">Seu dispositivo</small><strong id="diag-headline">Preparando um check-up rápido</strong><p id="diag-description">O navegador fará uma leitura básica automaticamente. No Windows, o diagnóstico completo pode identificar CPU, RAM, discos e vídeo.</p></div><div class="diag-actions"><button class="diag-adjust" type="button" id="diag-configure">Diagnosticar este PC</button><a class="button button-primary js-whatsapp" id="diag-cta" href="#" data-section="diagnostic" data-service="diagnostico" data-label="melhorar_pc">Vamos dar um Upgrade? <svg><use href="#i-arrow"/></svg></a></div></div>
          <div class="diagnostic-disclaimer">Check-up de orientação — não substitui diagnóstico técnico presencial.</div>
        </div>
      </div>
      <dialog class="diagnostic-dialog" id="diagnostic-dialog" aria-labelledby="diagnostic-dialog-title"><div class="powershell-flow"><div class="dialog-head"><div><span class="kicker">Diagnóstico completo · Windows</span><h2 id="diagnostic-dialog-title">Um clique para descobrir o que seu PC precisa.</h2></div><button class="dialog-close" type="button" aria-label="Fechar diagnóstico">×</button></div><p class="powershell-intro">Baixe e abra o iniciador com duplo clique. Ele executa a leitura e envia o resultado. Coleta somente processador, RAM, discos, vídeo e Windows.</p><ol class="powershell-steps"><li><span>01</span><div><strong>Baixe e abra o iniciador</strong><p>É exclusivo desta sessão e expira em 10 minutos.</p><a class="button button-primary" id="diagnostic-download" href="#" download="iniciar-diagnostico-infocore.cmd">Baixar e iniciar diagnóstico <svg><use href="#i-arrow"/></svg></a><button class="script-fallback" id="diagnostic-script" type="button">Ver código que será executado</button></div></li><li><span>02</span><div><strong>Aguarde a leitura</strong><p id="diagnostic-sync-status">Aguardando o diagnóstico do computador…</p><div class="sync-indicator" aria-hidden="true"><i></i><i></i><i></i></div></div></li></ol><button class="button button-ghost" type="button" id="diagnostic-check-now">Verificar novamente</button><small>A sessão fica apenas na memória do servidor e é descartada após expirar.</small></div></dialog>
      <dialog class="script-dialog" id="script-dialog" aria-labelledby="script-dialog-title"><div><div class="dialog-head"><div><span class="kicker">Código transparente</span><h2 id="script-dialog-title">O que será executado no seu computador</h2></div><button class="dialog-close" type="button" aria-label="Fechar código">×</button></div><pre id="script-code">Carregando código…</pre></div></dialog>
      <div class="container immediate-proof reveal"><a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" data-track="maps_click" data-section="hero"><svg><use href="#i-pin"/></svg><span><small>Atendimento presencial</small><strong><%= business.address.city %>, <%= business.address.region %></strong></span></a><div><svg><use href="#i-tool"/></svg><span><small>Do diagnóstico ao upgrade</small><strong>Soluções para PC e notebook</strong></span></div><a href="tel:<%= business.phoneE164 %>" data-track="phone_click" data-section="hero"><span class="proof-signal"></span><span><small>Contato direto</small><strong><%= business.phoneDisplay %></strong></span></a></div>
    </section>

    <section class="section services" id="servicos" data-observe="service_view">
      <div class="container"><div class="section-heading reveal"><div><span class="kicker">O que resolvemos</span><h2>Assistência que começa pelo problema real.</h2></div><p>Explique o que está acontecendo. A InfoCore orienta o próximo passo e indica a solução adequada ao seu equipamento.</p></div>
        <div class="service-bento">
          <% const services = [
            ['manutencao','Manutenção de computadores','Travamentos, aquecimento, ruídos ou falhas? Investigamos hardware e software antes de propor o serviço.','i-tool','wide'],
            ['notebook','Manutenção de notebooks','Avaliação de desempenho, teclado, tela, armazenamento e outros componentes.','i-laptop',''],
            ['upgrade','Upgrade de SSD e memória','Mais agilidade para iniciar, trabalhar e estudar sem trocar de máquina antes da hora.','i-drive','accent'],
            ['montagem','Montagem de computadores','Configuração pensada para sua necessidade, da escolha das peças à montagem.','i-chip',''],
            ['seguranca','Limpeza e segurança','Limpeza interna, cuidados térmicos e remoção de ameaças digitais.','i-shield','wide']
          ]; services.forEach((service, index) => { %>
          <article class="service-card <%= service[4] %> reveal" data-service="<%= service[0] %>"><div class="service-number">0<%= index + 1 %></div><svg class="service-icon"><use href="#<%= service[3] %>"/></svg><h3><%= service[1] %></h3><p><%= service[2] %></p><a class="service-link js-whatsapp" href="#" data-section="services" data-service="<%= service[0] %>" data-label="solicitar_servico">Quero resolver isso <svg><use href="#i-arrow"/></svg></a></article>
          <% }) %>
        </div>
        <div class="visual-services"><div class="visual-services-head reveal"><span>Serviços em detalhe</span><p>Fotos reais poderão substituir as ilustrações sem alterar o layout.</p></div><div class="visual-services-grid">
          <% serviceShowcase.forEach((item, index) => { %>
          <article class="visual-service reveal <%= index === 0 ? 'featured' : '' %>" data-service="<%= item.slug %>">
            <figure class="visual-service-media <%= item.image ? 'has-photo' : 'has-illustration visual-' + item.slug %>">
              <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.alt %>" width="800" height="600" loading="lazy" decoding="async"><% } else { %><div class="service-illustration" aria-hidden="true"><span class="illustration-device"></span><i></i><i></i><i></i></div><% } %>
              <span class="visual-service-tag"><%= item.tag %></span>
            </figure>
            <div class="visual-service-copy"><span>0<%= index + 1 %></span><div><h3><%= item.title %></h3><p><%= item.description %></p><a class="service-link js-whatsapp" href="#" data-section="visual_services" data-service="<%= item.slug %>" data-label="solicitar_servico">Quero saber mais <svg><use href="#i-arrow"/></svg></a></div></div>
          </article>
          <% }) %>
        </div></div>
      </div>
    </section>

    <section class="section why-us" id="diferenciais">
      <div class="container why-layout"><div class="why-copy reveal"><span class="kicker">Clareza em cada etapa</span><h2>Técnica por dentro.<br>Simples para você.</h2><p>Você não precisa entender de componentes para tomar uma boa decisão. O atendimento traduz o diagnóstico e ajuda a avaliar o que faz sentido para seu uso.</p><a class="text-link js-whatsapp" href="#" data-section="differentials" data-label="tirar_duvida">Tirar uma dúvida no WhatsApp <svg><use href="#i-arrow"/></svg></a></div><div class="feature-stack"><article class="feature reveal"><span>01</span><div><h3>Diagnóstico antes da solução</h3><p>O problema é avaliado antes da indicação de peças ou serviços.</p></div></article><article class="feature reveal"><span>02</span><div><h3>Orçamento compreensível</h3><p>Você recebe contexto para decidir com mais segurança.</p></div></article><article class="feature reveal"><span>03</span><div><h3>Atendimento próximo</h3><p>Contato direto com uma assistência local em Simão Dias.</p></div></article></div></div>
    </section>

    <section class="section process" id="processo">
      <div class="container"><div class="section-heading reveal"><div><span class="kicker">Como funciona</span><h2>Do primeiro contato ao equipamento pronto.</h2></div><p>Um fluxo simples para você saber o que acontece em seguida. Prazos e disponibilidade são confirmados no atendimento.</p></div><ol class="process-line"><li class="reveal"><b>01</b><span class="process-dot"></span><h3>Conte o problema</h3><p>Fale pelo WhatsApp e descreva os sintomas do equipamento.</p></li><li class="reveal"><b>02</b><span class="process-dot"></span><h3>Avaliação técnica</h3><p>A InfoCore verifica a causa e as opções de solução.</p></li><li class="reveal"><b>03</b><span class="process-dot"></span><h3>Orçamento</h3><p>Você recebe a proposta e decide antes da execução.</p></li><li class="reveal"><b>04</b><span class="process-dot"></span><h3>Serviço e entrega</h3><p>Após a aprovação, o serviço é realizado e a retirada é combinada.</p></li></ol></div>
    </section>

    <section class="section work" id="trabalhos" data-observe="portfolio_view">
      <div class="container"><div class="section-heading reveal"><div><span class="kicker">Por dentro da InfoCore</span><h2>Trabalho real, sem imagens de catálogo.</h2></div><p>A galeria é conectada ao Instagram profissional da InfoCore. Quando a API estiver ativa, publicações e bastidores aparecem aqui automaticamente.</p></div>
        <div class="instagram-grid" id="instagram-feed" aria-live="polite"><div class="feed-feature reveal"><img src="/public/img/showcase.webp" width="1024" height="864" loading="lazy" decoding="async" alt="Publicação da InfoCore apresentando acessórios de informática"><div><span>Conteúdo da marca</span><h3>Acessórios, peças e assistência em um só lugar.</h3></div></div><div class="feed-fallback reveal"><span class="feed-mark">@</span><h3>Acompanhe os trabalhos recentes</h3><p>Veja publicações, novidades e bastidores diretamente no perfil oficial.</p><a class="button button-ghost" href="<%= business.instagramUrl %>" target="_blank" rel="noopener" data-track="instagram_click" data-section="portfolio">Abrir <%= business.instagramHandle %> <svg><use href="#i-arrow"/></svg></a></div></div>
      </div>
    </section>

    <section class="section reviews" id="avaliacoes">
      <div class="container reviews-shell reveal"><div class="reviews-intro"><span class="kicker">Avaliações no Google</span><h2>Confiança se constrói com experiências reais.</h2><p id="reviews-summary">As avaliações serão exibidas diretamente pelo Google assim que a integração oficial for configurada.</p><div class="review-actions"><a class="button button-primary" id="reviews-link" href="<%= business.googleReviewsUrl || business.mapsUrl %>" target="_blank" rel="noopener" data-track="google_reviews_click" data-section="reviews">Ver perfil no Google <svg><use href="#i-arrow"/></svg></a><a class="text-link <%= business.googleReviewWriteUrl ? '' : 'is-hidden' %>" id="review-write-link" href="<%= business.googleReviewWriteUrl || '#' %>" target="_blank" rel="noopener">Avaliar a InfoCore</a></div></div><div class="reviews-content" id="reviews-content" aria-live="polite"><div class="review-placeholder"><div class="stars" aria-hidden="true">★★★★★</div><strong>Avaliações verificadas</strong><p>Nenhuma nota ou depoimento é inventado. Os dados desta área vêm da API oficial do Google.</p></div></div></div>
    </section>

    <section class="section products" id="produtos" data-observe="product_view"><div class="container"><div class="section-heading reveal"><div><span class="kicker">Upgrades e soluções</span><h2>Às vezes, uma troca certa muda a máquina inteira.</h2></div><p>Consulte disponibilidade e compatibilidade antes da compra. A recomendação considera o equipamento e seu tipo de uso.</p></div><div class="product-strip"><article class="product reveal" data-product="ssd"><small>Velocidade</small><h3>SSD</h3><p>Inicialização e abertura de programas mais rápidas.</p><a href="#" class="js-whatsapp" data-section="products" data-service="ssd" data-label="tenho_interesse">Consultar compatibilidade</a></article><article class="product reveal" data-product="memoria"><small>Multitarefa</small><h3>Memória RAM</h3><p>Mais fôlego para trabalhar com vários programas.</p><a href="#" class="js-whatsapp" data-section="products" data-service="memoria_ram" data-label="tenho_interesse">Consultar compatibilidade</a></article><article class="product reveal" data-product="componentes"><small>Configuração</small><h3>Peças e periféricos</h3><p>Componentes e acessórios conforme disponibilidade.</p><a href="#" class="js-whatsapp" data-section="products" data-service="pecas_perifericos" data-label="tenho_interesse">Consultar opções</a></article></div></div></section>

    <section class="section faq" id="faq"><div class="container faq-layout"><div class="faq-heading reveal"><span class="kicker">Perguntas frequentes</span><h2>Antes de levar seu equipamento.</h2><p>Algumas respostas dependem do diagnóstico. Quando precisar, fale diretamente com a InfoCore.</p></div><div class="accordion">
      <% const faqs = [['O orçamento é feito antes do serviço?','A proposta é apresentada para sua decisão antes da execução. Quando o diagnóstico exigir procedimento específico, as condições são informadas no atendimento.'],['Vocês atendem computadores e notebooks?','Sim. A InfoCore trabalha com manutenção, limpeza, upgrades e soluções para computadores e notebooks.'],['Quanto tempo demora o atendimento?','O prazo varia conforme o problema, a disponibilidade de peças e a fila de atendimento. A previsão é informada após a avaliação.'],['Meus arquivos ficam seguros durante a manutenção?','Informe no primeiro contato se há arquivos importantes. Nenhum serviço elimina todos os riscos: mantenha backup sempre que possível e confirme o procedimento antes de autorizar formatação ou intervenção no armazenamento.'],['Posso pedir upgrade de SSD ou memória?','Sim. A compatibilidade precisa ser verificada para indicar o componente adequado ao equipamento.'],['Há atendimento em domicílio ou coleta?','A disponibilidade e o tipo de serviço atendido fora da loja devem ser confirmados diretamente pelo WhatsApp.'],['O serviço tem garantia?','As condições dependem do serviço e das peças utilizadas. Peça os termos aplicáveis junto ao orçamento; esta página não promete uma condição genérica.']]; faqs.forEach((faq,index)=>{ %><details class="faq-item reveal"><summary><span><%= String(index+1).padStart(2,'0') %></span><%= faq[0] %><i></i></summary><div><p><%= faq[1] %></p></div></details><% }) %>
    </div></div></section>

    <section class="section contact" id="contato"><div class="container"><div class="contact-shell"><div class="contact-copy reveal"><span class="kicker">InfoCore em Simão Dias</span><h2>Conte o que está acontecendo.</h2><p>O caminho mais rápido é o WhatsApp. Se preferir, envie uma mensagem pelo formulário e a InfoCore retorna pelo contato informado.</p><a class="button button-primary js-whatsapp" href="#" data-section="contact" data-label="iniciar_atendimento"><svg><use href="#i-whatsapp"/></svg> Iniciar atendimento</a><div class="contact-details"><a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" data-track="maps_click" data-section="contact"><svg><use href="#i-pin"/></svg><span><small>Endereço</small><strong><%= business.address.street %><br><%= business.address.neighborhood %> · <%= business.address.city %>/<%= business.address.region %></strong></span></a><a href="tel:<%= business.phoneE164 %>" data-track="phone_click" data-section="contact"><svg><use href="#i-whatsapp"/></svg><span><small>Telefone e WhatsApp</small><strong><%= business.phoneDisplay %></strong></span></a></div></div>
          <form class="contact-form reveal" id="contact-form" novalidate><div class="form-title"><span>Mensagem</span><small>Campos marcados com * são obrigatórios</small></div><input class="honeypot" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"><input type="hidden" name="startedAt" value=""><label>Nome *<input name="name" autocomplete="name" required minlength="2"></label><div class="field-row"><label>E-mail<input type="email" name="email" autocomplete="email"></label><label>Telefone<input type="tel" name="phone" autocomplete="tel" inputmode="tel"></label></div><label>Como podemos ajudar? *<textarea name="message" required minlength="10" maxlength="2000" rows="5" placeholder="Descreva o equipamento e o problema"></textarea></label><p class="form-status" id="form-status" role="status"></p><button class="button button-primary" type="submit">Enviar mensagem <svg><use href="#i-arrow"/></svg></button><small class="form-privacy">Ao enviar, você concorda com o uso dos dados para responder ao contato. <a href="/privacidade">Saiba mais</a>.</small></form>
        </div></div></section>

    <section class="final-cta" data-observe="cta_view"><div class="container reveal"><span class="kicker">Seu próximo passo</span><h2>Vamos entender o que<br>seu equipamento precisa?</h2><a class="button button-light js-whatsapp" href="#" data-section="final_cta" data-label="solicitar_orcamento">Solicitar orçamento <svg><use href="#i-arrow"/></svg></a></div></section>
  </main>

  <footer class="site-footer"><div class="container footer-grid"><div><img src="/public/img/brand-header.webp" width="180" height="72" alt="InfoCore"><p>Assistência técnica, peças e soluções em informática em Simão Dias, Sergipe.</p></div><div><strong>Navegue</strong><a href="#servicos">Serviços</a><a href="#processo">Como funciona</a><a href="#faq">Dúvidas</a><a href="#contato">Contato</a></div><div><strong>Contato</strong><a href="tel:<%= business.phoneE164 %>" data-track="phone_click" data-section="footer"><%= business.phoneDisplay %></a><a href="mailto:<%= business.email %>" data-track="email_click" data-section="footer"><%= business.email %></a><a href="<%= business.instagramUrl %>" target="_blank" rel="noopener" data-track="instagram_click" data-section="footer"><%= business.instagramHandle %></a></div><div><strong>Endereço</strong><a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" data-track="maps_click" data-section="footer"><%= business.address.street %><br><%= business.address.neighborhood %> · <%= business.address.city %>/<%= business.address.region %></a><small>Consulte o horário antes de se deslocar.</small></div></div><div class="container footer-bottom"><span>© <%= new Date().getFullYear() %> InfoCore. Todos os direitos reservados.</span><div><a href="/privacidade">Privacidade</a><a href="/cookies">Cookies</a><button type="button" id="cookie-settings">Preferências de cookies</button></div></div></footer>

  <a class="mobile-whatsapp js-whatsapp" href="#" data-section="floating_mobile" data-label="whatsapp_flutuante" aria-label="Orçamento: falar com a InfoCore pelo WhatsApp"><svg><use href="#i-whatsapp"/></svg><span>Orçamento</span></a>
