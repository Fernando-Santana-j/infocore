<!doctype html>
<html lang="pt-BR">
<head><%- include('./reusable/head.ejs') %><%- include('./reusable/seo-jsonld.ejs') %></head>
<body>
  <%- include('./reusable/body.ejs') %>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <svg class="svg-sprite" aria-hidden="true"><symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol><symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.55-5.25A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.3 8.1c.3 3.5 2 5.2 5.5 5.6"/></symbol><symbol id="i-instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.7" r=".7" fill="currentColor" stroke="none"/></symbol><symbol id="i-play" viewBox="0 0 24 24"><path d="m9 7 8 5-8 5Z"/></symbol><symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2"/></symbol><symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a4.5 4.5 0 0 0-5.5 5.5l-6.3 6.3a2.1 2.1 0 0 0 3 3l6.3-6.3a4.5 4.5 0 0 0 5.5-5.5l-2.6 2.6-3-3Z"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="i-chip" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3M9 9h6v6H9z"/></symbol><symbol id="i-laptop" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="12" rx="2"/><path d="M2 20h20"/></symbol><symbol id="i-drive" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M7 15h.01M11 15h6"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6Z"/><path d="m8.5 12 2 2 5-5"/></symbol></svg>

  <svg class="svg-sprite" aria-hidden="true"><symbol id="i-whatsapp-clean" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12.04 2a9.84 9.84 0 0 0-8.38 15l-1.42 5 5.12-1.35A9.95 9.95 0 1 0 12.04 2Zm0 17.9a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.04.8.81-2.95-.2-.3a8.08 8.08 0 1 1 6.86 3.76Zm4.43-6.05c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2a7.3 7.3 0 0 1-1.35-1.68c-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z"/></symbol></svg>
  <header class="site-header" id="header">
    <nav class="nav container" aria-label="Navegação principal">
      <a class="brand" href="#inicio" aria-label="InfoCore, início"><img src="/public/img/brand-header.webp" width="180" height="72" alt="InfoCore"></a>
      <button class="menu-toggle" type="button" aria-controls="nav-menu" aria-expanded="false"><span></span><span></span><span></span><span class="sr-only">Abrir menu</span></button>
      <div class="nav-menu" id="nav-menu">
        <a href="#servicos" data-nav="servicos">Serviços</a><a href="/catalogo">Produtos</a><a href="#processo" data-nav="processo">Como funciona</a><a href="#trabalhos" data-nav="trabalhos">Trabalhos</a><a href="#faq" data-nav="faq">Dúvidas</a><a href="#contato" data-nav="contato">Contato</a>
        <a class="button button-small button-whatsapp js-whatsapp" href="#" data-section="header" data-label="falar_no_whatsapp"><svg><use href="#i-whatsapp"/></svg> Falar no WhatsApp</a>
      </div>
    </nav>
  </header>

  <main id="conteudo">
    <section class="hero" id="inicio" data-section="hero">
      <div class="hero-grid" aria-hidden="true"></div><div class="hero-orb hero-orb-a" aria-hidden="true"></div><div class="hero-orb hero-orb-b" aria-hidden="true"></div>
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow reveal"><span class="pulse"></span> Assistência técnica em Simão Dias · SE</div>
          <h1 class="reveal">Seu equipamento,<br><span>de volta ao ritmo.</span></h1>
          <p class="hero-lead reveal">Manutenção de computadores e notebooks, upgrades e montagem de PCs com diagnóstico claro e atendimento direto.</p>
          <div class="hero-actions reveal"><a class="button button-primary js-whatsapp" href="#" data-section="hero" data-label="solicitar_orcamento"><svg><use href="#i-whatsapp"/></svg> Solicitar orçamento</a><a class="button button-ghost tracked-link" href="#servicos" data-event="hero_cta_click" data-label="ver_servicos">Ver serviços <svg><use href="#i-arrow"/></svg></a></div>
          <ul class="trust-list reveal"><li><svg><use href="#i-check"/></svg> Atendimento local</li><li><svg><use href="#i-check"/></svg> Orçamento antes do serviço</li><li><svg><use href="#i-check"/></svg> Contato sem burocracia</li></ul>
        </div>
        <div class="diagnostic-shell reveal" id="diagnostic" aria-label="Assistente visual para conhecer e melhorar seu dispositivo">
          <div class="diagnostic-top"><span><i></i> INFOCORE / CHECK-UP DIGITAL</span><span class="diag-time" id="diag-state">ANALISANDO</span></div>
          <div class="device-stage" id="device-stage">
            <div class="pc-side" aria-hidden="true">
              <div class="pc-frame"><div class="rear-fan"></div><div class="board"><span class="socket"></span><span class="ram ram-a"></span><span class="ram ram-b"></span><span class="m2"></span></div><div class="gpu"><i></i><i></i></div><div class="psu">PSU</div><div class="front-fan fan-top"></div><div class="front-fan fan-bottom"></div><div class="scan-line"></div></div>
            </div>
            <div class="notebook-device" aria-hidden="true"><div class="notebook-screen"><span></span></div><div class="notebook-base"></div></div>
            <div class="phone-device" aria-hidden="true"><span></span><i></i></div>
            <svg class="device-connectors" aria-hidden="true"><g></g></svg>
            <div class="diag-node node-cpu"><span>PROCESSAMENTO</span><b id="diag-cpu">lendo dispositivo…</b></div>
            <div class="diag-node node-memory"><span>MEMÓRIA</span><b id="diag-memory">verificando…</b></div>
            <div class="diag-node node-storage"><span>ARMAZENAMENTO</span><b id="diag-profile">identificando…</b></div>
            <div class="diag-node node-gpu"><span>VÍDEO / GPU</span><b id="diag-gpu">aguardando…</b></div>
            <div class="diag-node node-model"><span>MODELO</span><b id="diag-model">detectando…</b></div>
            <div class="diag-node node-temperature"><span>TEMPERATURA</span><b id="diag-temp">não disponível</b></div>
          </div>
          <div class="diagnostic-result"><div><small id="diag-device-label">Seu dispositivo</small><strong id="diag-headline">Preparando um check-up rápido</strong><p id="diag-description">O navegador fará uma leitura básica automaticamente. No Windows, o diagnóstico completo pode identificar CPU, RAM, discos e vídeo.</p></div><div class="diag-actions"><button class="diag-adjust" type="button" id="diag-configure">Diagnosticar este PC</button><a class="button button-primary js-whatsapp" id="diag-cta" href="#" data-section="diagnostic" data-service="diagnostico" data-label="melhorar_pc">Vamos dar um Upgrade? <svg><use href="#i-arrow"/></svg></a></div></div>
          <div class="diagnostic-disclaimer">Check-up de orientação — não substitui diagnóstico técnico presencial.</div>
        </div>
      </div>
      <dialog class="diagnostic-dialog" id="diagnostic-dialog" aria-labelledby="diagnostic-dialog-title"><div class="powershell-flow"><div class="dialog-head"><div><span class="kicker">Diagnóstico completo · Windows</span><h2 id="diagnostic-dialog-title">Um clique para descobrir o que seu PC precisa.</h2></div><button class="dialog-close" type="button" aria-label="Fechar diagnóstico">×</button></div><p class="powershell-intro">Baixe e abra o iniciador com duplo clique. Ele executa a leitura e envia o resultado. Coleta somente processador, RAM, discos, vídeo e Windows.</p><ol class="powershell-steps"><li><span>01</span><div><strong>Baixe e abra o iniciador</strong><p>É exclusivo desta sessão e expira em 10 minutos.</p><a class="button button-primary" id="diagnostic-download" href="#" download="iniciar-diagnostico-infocore.cmd">Baixar e iniciar diagnóstico <svg><use href="#i-arrow"/></svg></a><button class="script-fallback" id="diagnostic-script" type="button">Ver código que será executado</button></div></li><li><span>02</span><div><strong>Aguarde a leitura</strong><p id="diagnostic-sync-status">Aguardando o diagnóstico do computador…</p><div class="sync-indicator" aria-hidden="true"><i></i><i></i><i></i></div></div></li></ol><button class="button button-ghost" type="button" id="diagnostic-check-now">Verificar novamente</button><small>A sessão fica apenas na memória do servidor e é descartada após expirar.</small></div></dialog>
      <dialog class="script-dialog" id="script-dialog" aria-labelledby="script-dialog-title"><div><div class="dialog-head"><div><span class="kicker">Código transparente</span><h2 id="script-dialog-title">O que será executado no seu computador</h2></div><button class="dialog-close" type="button" aria-label="Fechar código">×</button></div><pre id="script-code">Carregando código…</pre></div></dialog>
      <div class="container immediate-proof reveal"><a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" data-track="maps_click" data-section="hero"><svg><use href="#i-pin"/></svg><span><small>Atendimento presencial</small><strong><%= business.address.street %><br><%= business.address.neighborhood %> · <%= business.address.city %>/<%= business.address.region %> · CEP <%= business.address.postalCode %></strong></span></a><div><svg><use href="#i-clock"/></svg><span><small>Horário de atendimento</small><strong>Segunda a sábado · <%= business.hours.mondayToSaturday %><br>Domingo · <%= business.hours.sunday %></strong></span></div><a href="tel:<%= business.phoneE164 %>" data-track="phone_click" data-section="hero"><span class="proof-signal"></span><span><small>Contato direto</small><strong><%= business.phoneDisplay %></strong></span></a></div>
    </section>

    <section class="section services" id="servicos" data-observe="service_view">
      <div class="container"><div class="section-heading services-heading reveal"><div><span class="kicker">O que resolvemos</span><h2>O serviço certo começa entendendo o problema.</h2></div><p>Manutenção, reparos e melhorias para computadores e notebooks, sempre com avaliação antes da execução.</p></div>
        <div class="visual-services service-catalog"><div class="visual-services-grid">
          <% serviceShowcase.forEach((item, index) => { %>
          <article class="visual-service reveal" data-service="<%= item.slug %>">
            <figure class="visual-service-media <%= item.image ? 'has-photo' : 'has-illustration visual-' + item.slug %>">
              <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.alt %>" width="800" height="600" loading="lazy" decoding="async"><% } else { %><div class="service-illustration" aria-hidden="true"><span class="illustration-device"></span><i></i><i></i><i></i></div><% } %>
              <span class="visual-service-tag"><%= item.tag %></span>
            </figure>
            <div class="visual-service-copy"><span>0<%= index + 1 %></span><div><h3><%= item.title %></h3><p><%= item.description %></p><a class="service-link js-whatsapp" href="#" data-section="services" data-service="<%= item.slug %>" data-label="solicitar_servico">Solicitar atendimento <svg><use href="#i-arrow"/></svg></a></div></div>
          </article>
          <% }) %>
        </div></div>
        <a class="services-catalog-link reveal" href="/catalogo"><span><small>Peças e acessórios</small><strong>Explore o catálogo da InfoCore</strong><p>Preços e disponibilidade atualizados diretamente pelo nosso sistema.</p></span><b>Ver produtos <svg><use href="#i-arrow"/></svg></b></a>
      </div>
    </section>

    <section class="section process process-unified" id="processo">
      <div class="container process-layout"><div class="process-intro reveal"><span class="kicker">Como funciona</span><h2>Técnica por dentro.<br>Simples para você.</h2><p>Você explica o problema e acompanha uma jornada clara, do diagnóstico à entrega, sem precisar entender de componentes.</p><a class="button button-primary js-whatsapp" href="#" data-section="process" data-label="iniciar_atendimento">Começar pelo WhatsApp <svg><use href="#i-arrow"/></svg></a><small>Atendimento direto em Simão Dias</small></div><ol class="process-journey"><li class="journey-step reveal"><span>01</span><div><small>Primeiro contato</small><h3>Conte o que está acontecendo</h3><p>Descreva os sintomas pelo WhatsApp para receber a orientação inicial.</p></div></li><li class="journey-step reveal"><span>02</span><div><small>Avaliação técnica</small><h3>Diagnóstico antes da solução</h3><p>A causa é investigada antes de indicar peças ou serviços.</p></div></li><li class="journey-step reveal"><span>03</span><div><small>Decisão tranquila</small><h3>Orçamento claro</h3><p>Você entende as opções, recebe a proposta e decide antes da execução.</p></div></li><li class="journey-step reveal"><span>04</span><div><small>Conclusão</small><h3>Serviço e entrega combinada</h3><p>Depois da aprovação, o serviço é realizado e a retirada é confirmada.</p></div></li></ol></div>
    </section>

    <section class="section work" id="trabalhos" data-observe="portfolio_view">
      <div class="container"><div class="section-heading social-heading reveal"><div><span class="kicker">Direto do Instagram</span><h2>Os últimos trabalhos,<br>do jeito que aconteceram.</h2></div><div class="social-heading-aside"><p>Novidades, montagens e bastidores publicados pela InfoCore, atualizados automaticamente.</p><a class="instagram-profile-link" href="<%= business.instagramUrl %>" target="_blank" rel="noopener" data-track="instagram_click" data-section="portfolio"><svg><use href="#i-instagram"/></svg><span class="instagram-profile-copy"><small>Perfil oficial no Instagram</small><strong><%= business.instagramHandle %></strong></span><span class="instagram-link-action">Seguir <svg><use href="#i-arrow"/></svg></span></a></div></div>
        <div class="instagram-grid" id="instagram-feed" aria-live="polite" aria-busy="<%= integrations.instagram ? 'true' : 'false' %>"><div class="feed-feature reveal"><img src="/public/img/showcase.webp" width="1024" height="864" loading="lazy" decoding="async" alt="Publicação da InfoCore apresentando acessórios de informática"><div><span>InfoCore por dentro</span><h3>Acessórios, peças e assistência em um só lugar.</h3><small>Veja novidades e bastidores no perfil oficial</small></div></div><div class="feed-fallback reveal"><span class="feed-mark"><svg><use href="#i-instagram"/></svg></span><span class="feed-status"><i></i> Perfil oficial</span><h3>Acompanhe de perto</h3><p>Os posts mais recentes aparecerão aqui automaticamente com a integração ativa.</p><a class="button button-ghost" href="<%= business.instagramUrl %>" target="_blank" rel="noopener" data-track="instagram_click" data-section="portfolio">Ver no Instagram <svg><use href="#i-arrow"/></svg></a></div></div>
      </div>
    </section>

    <section class="section reviews" id="avaliacoes">
      <div class="container reviews-shell google-embed-shell reveal">
        <div class="reviews-top"><div class="reviews-intro"><span class="kicker">Avaliações no Google</span><h2>A confiança de quem<br>já conhece a InfoCore.</h2><p>Nota, estrelas e avaliações sincronizadas automaticamente com o perfil público da InfoCore.</p></div><aside class="embed-trust" aria-label="Resumo das avaliações públicas no Google"><div class="embed-trust-head"><span class="google-g" aria-hidden="true">G</span><div><strong>Perfil oficial no Google</strong><small><i></i> Avaliações públicas verificadas</small></div><div class="embed-rating"><strong id="google-rating"><%= Number(googleReviewSnapshot.rating).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) %></strong><span><span class="embed-stars" id="google-stars" aria-label="<%= googleReviewSnapshot.rating %> de 5 estrelas">★★★★★</span><small id="google-rating-count"><%= googleReviewSnapshot.count %> avaliações</small></span></div></div>
          <div class="google-review-rotator" data-review-rotator aria-live="polite"><div class="google-review-stage"><% googleReviewSnapshot.reviews.forEach((review, index) => { const stars = Math.round(Number(review.rating) || 5); %><blockquote class="google-review-slide <%= index === 0 ? 'is-active' : '' %>" data-review-slide aria-hidden="<%= index === 0 ? 'false' : 'true' %>"><span class="review-quote-mark" aria-hidden="true">“</span><p><%= review.text || `Avaliou a InfoCore com ${stars} estrelas no Google.` %></p><footer><span class="review-person"><i aria-hidden="true"><%= review.name.charAt(0) %></i><span><strong><%= review.name %></strong><small><%= review.date || 'Avaliação publicada no Google' %></small></span></span><span class="review-stars" aria-label="<%= stars %> de 5 estrelas"><%= '★'.repeat(stars) %><%= '☆'.repeat(5 - stars) %></span></footer></blockquote><% }) %></div><div class="review-rotator-footer"><span class="review-position"><b data-review-current>01</b><i></i><span data-review-total><%= String(googleReviewSnapshot.reviews.length).padStart(2, '0') %></span></span><div class="review-progress" aria-hidden="true"><i></i></div><div class="review-controls"><button type="button" data-review-prev aria-label="Avaliação anterior"><svg><use href="#i-arrow"/></svg></button><button type="button" data-review-next aria-label="Próxima avaliação"><svg><use href="#i-arrow"/></svg></button></div></div></div>
        </aside></div>
        <div class="google-embed-card"><iframe src="<%= googleMapsEmbedUrl %>" title="InfoCore no Google Maps — nota e avaliações" width="1200" height="520" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><div class="embed-review-footer"><p>As avaliações ficam guardadas em cache e novas publicações entram automaticamente. O mapa continua disponível como fonte oficial.</p><div class="review-actions"><a class="button button-primary" id="reviews-link" href="<%= business.googleReviewsUrl || business.mapsUrl %>" target="_blank" rel="noopener" data-track="google_reviews_click" data-section="reviews">Ler todas as avaliações <svg><use href="#i-arrow"/></svg></a><a class="text-link <%= business.googleReviewWriteUrl ? '' : 'is-hidden' %>" id="review-write-link" href="<%= business.googleReviewWriteUrl || '#' %>" target="_blank" rel="noopener">Deixar uma avaliação</a></div></div>
      </div>
    </section>

    <section class="section faq" id="faq"><div class="container faq-layout"><div class="faq-heading reveal"><span class="kicker">Perguntas frequentes</span><h2>Antes de levar seu equipamento.</h2><p>Algumas respostas dependem do diagnóstico. Quando precisar, fale diretamente com a InfoCore.</p></div><div class="accordion">
      <% const faqs = [['O orçamento é feito antes do serviço?','A proposta é apresentada para sua decisão antes da execução. Quando o diagnóstico exigir procedimento específico, as condições são informadas no atendimento.'],['Vocês atendem computadores e notebooks?','Sim. A InfoCore trabalha com manutenção, limpeza, upgrades e soluções para computadores e notebooks.'],['Quanto tempo demora o atendimento?','O prazo varia conforme o problema, a disponibilidade de peças e a fila de atendimento. A previsão é informada após a avaliação.'],['Meus arquivos ficam seguros durante a manutenção?','Informe no primeiro contato se há arquivos importantes. Nenhum serviço elimina todos os riscos: mantenha backup sempre que possível e confirme o procedimento antes de autorizar formatação ou intervenção no armazenamento.'],['Posso pedir upgrade de SSD ou memória?','Sim. A compatibilidade precisa ser verificada para indicar o componente adequado ao equipamento.'],['Há atendimento em domicílio ou coleta?','A disponibilidade e o tipo de serviço atendido fora da loja devem ser confirmados diretamente pelo WhatsApp.'],['O serviço tem garantia?','As condições dependem do serviço e das peças utilizadas. Peça os termos aplicáveis junto ao orçamento; esta página não promete uma condição genérica.']]; faqs.forEach((faq,index)=>{ %><details class="faq-item reveal"><summary><span><%= String(index+1).padStart(2,'0') %></span><%= faq[0] %><i></i></summary><div><p><%= faq[1] %></p></div></details><% }) %>
    </div></div></section>

    <section class="section contact" id="contato"><div class="container"><div class="contact-shell"><div class="contact-copy reveal"><span class="kicker">InfoCore em Simão Dias</span><h2>Conte o que está acontecendo.</h2><p>O caminho mais rápido é o WhatsApp. Se preferir, envie uma mensagem pelo formulário e a InfoCore retorna pelo contato informado.</p><a class="button button-primary js-whatsapp" href="#" data-section="contact" data-label="iniciar_atendimento"><svg><use href="#i-whatsapp"/></svg> Iniciar atendimento</a><div class="contact-details"><a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" data-track="maps_click" data-section="contact"><svg><use href="#i-pin"/></svg><span><small>Endereço</small><strong><%= business.address.street %><br><%= business.address.neighborhood %> · <%= business.address.city %>/<%= business.address.region %></strong></span></a><a href="tel:<%= business.phoneE164 %>" data-track="phone_click" data-section="contact"><svg><use href="#i-whatsapp"/></svg><span><small>Telefone e WhatsApp</small><strong><%= business.phoneDisplay %></strong></span></a></div></div>
          <form class="contact-form reveal" id="contact-form" novalidate><div class="form-title"><span>Mensagem</span><small>Campos marcados com * são obrigatórios</small></div><input class="honeypot" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"><input type="hidden" name="startedAt" value=""><label>Nome *<input name="name" autocomplete="name" required minlength="2"></label><div class="field-row"><label>E-mail<input type="email" name="email" autocomplete="email"></label><label>Telefone<input type="tel" name="phone" autocomplete="tel" inputmode="tel"></label></div><label>Como podemos ajudar? *<textarea name="message" required minlength="10" maxlength="2000" rows="5" placeholder="Descreva o equipamento e o problema"></textarea></label><p class="form-status" id="form-status" role="status"></p><button class="button button-primary" type="submit">Enviar mensagem <svg><use href="#i-arrow"/></svg></button><small class="form-privacy">Ao enviar, você concorda com o uso dos dados para responder ao contato. <a href="/privacidade">Saiba mais</a>.</small></form>
        </div></div></section>

    <section class="final-cta" data-observe="cta_view"><div class="container reveal"><span class="kicker">Seu próximo passo</span><h2>Vamos entender o que<br>seu equipamento precisa?</h2><a class="button button-light js-whatsapp" href="#" data-section="final_cta" data-label="solicitar_orcamento">Solicitar orçamento <svg><use href="#i-arrow"/></svg></a></div></section>
  </main>

